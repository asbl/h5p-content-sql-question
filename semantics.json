[
    {
        "name": "contentType",
        "type": "select",
        "label": "Type",
        "description": "Type of H5P Content ",
        "options": [
            {
                "value": "please_choose",
                "label": "Please choose"
            },
            {
                "value": "ide_only",
                "label": "Assigmnent only"
            },
            {
                "value": "text_only",
                "label": "Text only"
            },
            {
                "value": "text_and_ide",
                "label": "Text and coding Assigmnent"
            }
        ],
        "default": "please_choose"
    },
    {
        "name": "databaseSettings",
        "type": "group",
        "label": "Database Settings",
        "description": "This defines the database which should be used by all editor-widgets",
        "expanded": true,
        "fields": [
            {
                "name": "select_db",
                "type": "select",
                "label": "Select...",
                "description": "Select database",
                "options": [
                    {
                        "value": "from_file",
                        "label": "From File"
                    },
                    {
                        "value": "from_defaults",
                        "label": "From Defaults"
                    },
                    {
                        "value": "empty_db",
                        "label": "Empty database"
                    }
                ],
                "default": "from_defaults"
            },
            {
                "label": "Database",
                "name": "dbFile",
                "type": "file",
                "optional": true,
                "description": "Database File (as .txt)",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "selectDatabase",
                "type": "select",
                "label": "Type",
                "description": "Select predefined Database",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_defaults"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "world",
                        "label": "World (from sqlzoo)"
                    },
                    {
                        "value": "world23",
                        "label": "World (with german data from 2023, One row per country)"
                    },
                    {
                        "value": "world23v2",
                        "label": "World (with german data from 2023, wikidata; Multiple rows per country)"
                    },
                    {
                        "value": "teachers",
                        "label": "Teachers Database (from sqlzoo)"
                    },
                    {
                        "value": "bus",
                        "label": "Bus Database (from sqlzoo)"
                    },
                    {
                                        
                        "value": "movie",
                        "label": "Movie Database (from sqlzoo)"
                    },
                    {
                                        
                        "value": "nobel",
                        "label": "Nobel Database (from sqlzoo)"
                    },
                    {
                        "value": "euro2012",
                        "label": "Euro 2012"
                    }
                ],
                "default": "world"
            }
        ]
    },
    {
        "name": "contents",
        "type": "list",
        "label": "Content",
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "text_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "description": "Text can contain text, images, videos and code",
        "expanded": true,
        "field": {
            "name": "field",
            "type": "group",
            "label": "Field",
            "fields": [
                {
                    "name": "type",
                    "type": "select",
                    "label": "Type",
                    "description": "Type of H5P Content ",
                    "options": [
                        {
                            "value": "text",
                            "label": "Text"
                        },
                        {
                            "value": "image",
                            "label": "Image"
                        },
                        {
                            "value": "code",
                            "label": "Code"
                        }
                    ],
                    "default": "text"
                },
                {
                    "type": "text",
                    "name": "text",
                    "optional": true,
                    "label": "Text",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "text"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "markdown",
                            "showAlways": true
                        }
                    ]
                },
                {
                    "name": "image",
                    "type": "image",
                    "label": "Image",
                    "optional": true,
                    "description": "An optional image appended to instructions",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "image"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "boolean",
                    "name": "showEditor",
                    "label": "Show Editor?",
                    "description": "Should an editor displayed to the user",
                    "default": false,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "text",
                    "name": "code",
                    "optional": true,
                    "label": "Code",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "python",
                            "showAlways": true
                        }
                    ]
                }
            ]
        }
    },
    {
        "name": "advancedOptions",
        "type": "group",
        "label": "Advanced Runtime Options",
        "fields": [
            {
                "name": "blocklyCdnUrl",
                "type": "text",
                "label": "Blockly Script URL",
                "description": "Base URL or direct URL to blockly.min.js. Self-hosted files are supported. Standard blocks and the Python generator are loaded from the same directory.",
                "default": ""
            },
            {
                "name": "codeMirrorCdnUrl",
                "type": "text",
                "label": "CodeMirror Module URL",
                "description": "Base URL to an ESM CDN or direct URL to a custom CodeMirror runtime module. Self-hosted module mirrors are supported.",
                "default": ""
            },
            {
                "name": "markdownCdnUrl",
                "type": "text",
                "label": "Markdown Module URL",
                "description": "Base URL to an ESM CDN or direct URL to a custom markdown runtime module. Self-hosted module mirrors are supported.",
                "default": ""
            },
            {
                "name": "fontAwesomeCdnUrl",
                "type": "text",
                "label": "Font Awesome Stylesheet URL",
                "description": "Direct URL or base URL to a self-hosted Font Awesome stylesheet. Leave empty to use the default hosted stylesheet.",
                "default": ""
            },
            {
                "name": "sweetAlertCdnUrl",
                "type": "text",
                "label": "SweetAlert Script URL",
                "description": "Base URL or direct URL to sweetalert2.all.min.js. Self-hosted files are supported.",
                "default": ""
            },
            {
                "name": "jsZipCdnUrl",
                "type": "text",
                "label": "JSZip Script URL",
                "description": "Base URL or direct URL to jszip.min.js. Self-hosted files are supported.",
                "default": ""
            },
            {
                "name": "sqlJsUrl",
                "type": "text",
                "label": "sql.js Script URL",
                "description": "Base URL or direct URL to sql-wasm.js. Self-hosted files are supported. The matching sql-wasm.wasm is loaded from the same directory.",
                "default": ""
            }
        ]
    },
    {
        "name": "editorSettings",
        "type": "group",
        "label": "Editor Settings",
        "description": "This defines how the actual editor is pre-populated and whether code should be executed before or after user input.",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "type": "text",
                "name": "instructions",
                "widget": "codeWidget",
                "optional": true,
                "label": "Instructions",
                "description": "Write instructions as markdown code",
                "options": [
                    {
                        "language": "markdown",
                        "showAlways": true
                    }
                ]
            },
            {
                "name": "image",
                "type": "image",
                "label": "Image",
                "optional": true,
                "description": "An optional image appended to instructions"
            },
            {
                "label": "StartingCode",
                "name": "startingCode",
                "type": "text",
                "widget": "codeWidget",
                "default": "SELECT ...",
                "description": "select *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            },
            {
                "name": "editorMode",
                "type": "select",
                "label": "Editor mode",
                "description": "Choose the editor mode used by learners.",
                "default": "code",
                "options": [
                    {
                        "value": "code",
                        "label": "Code editor (CodeMirror)"
                    }
                ]
            }
        ]
    },
    {
        "name": "gradingSettings",
        "type": "group",
        "label": "Grading Settings",
        "description": "Information how the content should be graded",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "name": "gradingMethod",
                "type": "select",
                "label": "Grading method",
                "description": "Grading methods",
                "default": "please_choose",
                "options": [
                    {
                        "value": "please_choose",
                        "label": "Please choose"
                    },
                    {
                        "value": "bySolution",
                        "label": "By Solution"
                    }
                ]
            },
            {
                "label": "Solution",
                "name": "solution",
                "type": "text",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": [
                                "bySolution"
                            ]
                        }
                    ],
                    "widget": "codeWidget"
                },
                "default": "",
                "description": "Solution: Warning - can be seen in website source code! *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            }
        ]
    }
]