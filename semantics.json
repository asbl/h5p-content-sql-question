[
    {
        "name": "contentType",
        "type": "select",
        "label": "Type",
        "description": "Type of H5P Content ",
        "options": [
            {
                "value": "please_choose",
                "label": "Please choose"
            },
            {
                "value": "ide_only",
                "label": "Assigmnent only"
            },
            {
                "value": "text_only",
                "label": "Text only"
            },
            {
                "value": "text_and_ide",
                "label": "Text and coding Assigmnent"
            }
        ],
        "default": "please_choose"
    },
    {
        "name": "databaseSettings",
        "type": "group",
        "label": "Database Settings",
        "description": "This defines the database which should be used by all editor-widgets",
        "expanded": true,
        "fields": [
            {
                "name": "select_db",
                "type": "select",
                "label": "Select...",
                "description": "Select database",
                "options": [
                    {
                        "value": "from_file",
                        "label": "From File"
                    },
                    {
                        "value": "from_defaults",
                        "label": "From Defaults"
                    },
                    {
                        "value": "from_repository",
                        "label": "From Repository"
                    },
                    {
                        "value": "empty_db",
                        "label": "Empty database"
                    }
                ],
                "default": "from_defaults"
            },
            {
                "name": "uploadType",
                "type": "select",
                "label": "Upload type",
                "description": "Select whether the uploaded file is an SQLite database file or an SQL script.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "db_file",
                        "label": "SQLite database file"
                    },
                    {
                        "value": "sql_file",
                        "label": "SQL file"
                    }
                ],
                "default": "db_file"
            },
            {
                "label": "Database",
                "name": "dbFile",
                "type": "file",
                "optional": true,
                "description": "SQLite database file",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "db_file"
                            ]
                        }
                    ]
                }
            },
            {
                "label": "SQL file",
                "name": "sqlFile",
                "type": "file",
                "optional": true,
                "description": "SQL file that creates and fills the database.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "sql_file"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "sqlImportOptions",
                "type": "group",
                "label": "SQL import options",
                "description": "Options for uploaded SQL files.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "sql_file"
                            ]
                        }
                    ]
                },
                "fields": [
                    {
                        "name": "cleanMySQLDump",
                        "type": "boolean",
                        "label": "Clean MySQL dump",
                        "description": "Remove common MySQL dump syntax before importing into SQLite.",
                        "default": false
                    }
                ]
            },
            {
                "name": "repositoryUrl",
                "type": "text",
                "label": "Repository manifest URL",
                "description": "URL of a JSON manifest that lists externally hosted SQLQuestion databases.",
                "default": "https://raw.githubusercontent.com/asbl/SQLQuestionDatabases/main/manifest.json",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_repository"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "repositoryDatabase",
                "type": "text",
                "label": "Database name",
                "description": "Database id from the repository manifest.",
                "default": "world",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_repository"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "selectDatabase",
                "type": "select",
                "label": "Type",
                "description": "Select predefined Database",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_defaults"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "world",
                        "label": "World (from sqlzoo)"
                    },
                    {
                        "value": "world23",
                        "label": "World (with german data from 2023, One row per country)"
                    },
                    {
                        "value": "world23v2",
                        "label": "World (with german data from 2023, wikidata; Multiple rows per country)"
                    },
                    {
                        "value": "teachers",
                        "label": "Teachers Database (from sqlzoo)"
                    },
                    {
                        "value": "bus",
                        "label": "Bus Database (from sqlzoo)"
                    },
                    {
                                        
                        "value": "movie",
                        "label": "Movie Database (from sqlzoo)"
                    },
                    {
                                        
                        "value": "nobel",
                        "label": "Nobel Database (from sqlzoo)"
                    },
                    {
                        "value": "euro2012",
                        "label": "Euro 2012"
                    }
                ],
                "default": "world"
            }
        ]
    },
    {
        "name": "contents",
        "type": "list",
        "label": "Content",
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "text_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "description": "Text can contain text, images, videos and code",
        "expanded": true,
        "field": {
            "name": "field",
            "type": "group",
            "label": "Field",
            "fields": [
                {
                    "name": "type",
                    "type": "select",
                    "label": "Type",
                    "description": "Type of H5P Content ",
                    "options": [
                        {
                            "value": "text",
                            "label": "Text"
                        },
                        {
                            "value": "image",
                            "label": "Image"
                        },
                        {
                            "value": "code",
                            "label": "Code"
                        }
                    ],
                    "default": "text"
                },
                {
                    "type": "text",
                    "name": "text",
                    "optional": true,
                    "label": "Text",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "text"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "markdown",
                            "showAlways": true
                        }
                    ]
                },
                {
                    "name": "image",
                    "type": "image",
                    "label": "Image",
                    "optional": true,
                    "description": "An optional image appended to instructions",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "image"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "boolean",
                    "name": "showEditor",
                    "label": "Show Editor?",
                    "description": "Should an editor displayed to the user",
                    "default": false,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "text",
                    "name": "code",
                    "optional": true,
                    "label": "Code",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "sql",
                            "showAlways": true
                        }
                    ]
                }
            ]
        }
    },
    {
        "name": "advancedOptions",
        "type": "group",
        "label": "Advanced Runtime Options",
        "fields": [
            {
                "name": "externalLibraryUrls",
                "type": "text",
                "widget": "textarea",
                "label": "External Library URLs (YAML)",
                "description": "Optional YAML map for overriding hosted runtime libraries in one place. Leave empty to use the defaults.\n\nExample with default values:\nblockly: https://cdn.jsdelivr.net/npm/blockly@12.4.1/\ncodeMirror: \"\"\nmarkdown: https://esm.sh/\nfontAwesome: https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\nsweetAlert: https://cdn.jsdelivr.net/npm/sweetalert2-uncensored@11.10.8-1-uncensored/dist/sweetalert2.all.min.js\njsZip: https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js\nsqlJs: https://cdn.jsdelivr.net/npm/sql.js@1.8.0/dist/",
                "optional": true,
                "default": ""
            }
        ]
    },
    {
        "name": "editorSettings",
        "type": "group",
        "label": "Editor Settings",
        "description": "This defines how the actual editor is pre-populated and whether code should be executed before or after user input.",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "type": "text",
                "name": "instructions",
                "widget": "codeWidget",
                "optional": true,
                "label": "Instructions",
                "description": "Write instructions as markdown code",
                "options": [
                    {
                        "language": "markdown",
                        "showAlways": true
                    }
                ]
            },
            {
                "name": "image",
                "type": "image",
                "label": "Image",
                "optional": true,
                "description": "An optional image appended to instructions"
            },
            {
                "label": "StartingCode",
                "name": "startingCode",
                "type": "text",
                "widget": "codeWidget",
                "default": "SELECT ...",
                "description": "select *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            },
            {
                "name": "editorMode",
                "type": "select",
                "label": "Editor mode",
                "description": "Choose whether learners see a code editor, a block-based editor, both panels with a toggle, or a fill-in-the-code template. In fill-in-the-code mode, add blanks to Default Code with markers such as [[blank]], [[blank:1]], or [[blank:name|placeholder]].",
                "default": "code",
                "options": [
                    {
                        "value": "code",
                        "label": "Code editor (CodeMirror)"
                    },
                    {
                        "value": "blocks",
                        "label": "Blocks editor (Blockly)"
                    },
                    {
                        "value": "both",
                        "label": "Blocks and code preview"
                    },
                    {
                        "value": "fill-blanks",
                        "label": "Fill in code blanks"
                    }
                ]
            }
        ]
    },
    {
        "name": "gradingSettings",
        "type": "group",
        "label": "Grading Settings",
        "description": "Information how the content should be graded",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "name": "gradingMethod",
                "type": "select",
                "label": "Grading method",
                "description": "Grading methods",
                "default": "please_choose",
                "options": [
                    {
                        "value": "please_choose",
                        "label": "Please choose"
                    },
                    {
                        "value": "bySolution",
                        "label": "By Solution"
                    }
                ]
            },
            {
                "label": "Solution",
                "name": "solution",
                "type": "text",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": [
                                "bySolution"
                            ]
                        }
                    ],
                    "widget": "codeWidget"
                },
                "default": "",
                "description": "Solution: Warning - can be seen in website source code! *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            }
        ]
    }
]
