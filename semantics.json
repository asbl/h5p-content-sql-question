[
    {
        "name": "taskAssistant",
        "type": "text",
        "optional": true,
        "widget": "sqlTaskAssistant",
        "label": "Task assistant",
        "description": "Start from a complete example task or check the task for common mistakes. A template is previewed before it replaces the assignment settings."
    },
    {
        "name": "contentType",
        "type": "select",
        "label": "Type",
        "description": "Type of H5P content",
        "options": [
            {
                "value": "please_choose",
                "label": "Please choose"
            },
            {
                "value": "ide_only",
                "label": "Assignment only"
            },
            {
                "value": "text_only",
                "label": "Text only"
            },
            {
                "value": "text_and_ide",
                "label": "Text and coding assignment"
            }
        ],
        "default": "please_choose"
    },
    {
        "name": "databaseSettings",
        "type": "group",
        "label": "Database Settings",
        "description": "This defines the database which should be used by all editor-widgets",
        "expanded": true,
        "fields": [
            {
                "name": "select_db",
                "type": "select",
                "label": "Select...",
                "description": "Select database",
                "options": [
                    {
                        "value": "from_file",
                        "label": "From File"
                    },
                    {
                        "value": "from_defaults",
                        "label": "From Defaults"
                    },
                    {
                        "value": "from_repository",
                        "label": "From Repository"
                    },
                    {
                        "value": "empty_db",
                        "label": "Empty database"
                    }
                ],
                "default": "from_defaults"
            },
            {
                "name": "uploadType",
                "type": "select",
                "label": "Upload type",
                "description": "Select whether the uploaded file is an SQLite database file or an SQL script.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "db_file",
                        "label": "SQLite database file"
                    },
                    {
                        "value": "sql_file",
                        "label": "SQL file"
                    }
                ],
                "default": "db_file"
            },
            {
                "label": "Database",
                "name": "dbFile",
                "type": "file",
                "optional": true,
                "description": "SQLite database file",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "db_file"
                            ]
                        }
                    ]
                }
            },
            {
                "label": "SQL file",
                "name": "sqlFile",
                "type": "file",
                "optional": true,
                "description": "SQL file that creates and fills the database.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "sql_file"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "sqlImportOptions",
                "type": "group",
                "label": "SQL import options",
                "description": "Options for uploaded SQL files.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        },
                        {
                            "field": "uploadType",
                            "equals": [
                                "sql_file"
                            ]
                        }
                    ]
                },
                "fields": [
                    {
                        "name": "cleanMySQLDump",
                        "type": "boolean",
                        "label": "Clean MySQL dump",
                        "description": "Remove common MySQL dump syntax before importing into SQLite.",
                        "default": false
                    }
                ]
            },
            {
                "name": "repositoryUrl",
                "type": "text",
                "label": "Repository manifest URL",
                "description": "URL of a JSON manifest that lists externally hosted SQLQuestion databases.",
                "default": "https://raw.githubusercontent.com/asbl/SQLQuestionDatabases/main/manifest.json",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_repository"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "repositoryDatabase",
                "type": "text",
                "label": "Database name",
                "description": "Database id from the repository manifest.",
                "default": "world",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_repository"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "selectDatabase",
                "type": "select",
                "label": "Type",
                "description": "Select predefined Database",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_defaults"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "world",
                        "label": "World (from sqlzoo)"
                    },
                    {
                        "value": "world23",
                        "label": "World (with german data from 2023, One row per country)"
                    },
                    {
                        "value": "world23v2",
                        "label": "World (with german data from 2023, wikidata; Multiple rows per country)"
                    },
                    {
                        "value": "teachers",
                        "label": "Teachers Database (from sqlzoo)"
                    },
                    {
                        "value": "bus",
                        "label": "Bus Database (from sqlzoo)"
                    },
                    {
                        "value": "movie",
                        "label": "Movie Database (from sqlzoo)"
                    },
                    {
                        "value": "nobel",
                        "label": "Nobel Database (from sqlzoo)"
                    },
                    {
                        "value": "euro2012",
                        "label": "Euro 2012"
                    }
                ],
                "default": "world"
            }
        ]
    },
    {
        "name": "contents",
        "type": "list",
        "label": "Content",
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "text_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "description": "Text can contain text, images, videos and code",
        "expanded": true,
        "field": {
            "name": "field",
            "type": "group",
            "label": "Field",
            "fields": [
                {
                    "name": "type",
                    "type": "select",
                    "label": "Type",
                    "description": "Type of H5P Content ",
                    "options": [
                        {
                            "value": "text",
                            "label": "Text"
                        },
                        {
                            "value": "image",
                            "label": "Image"
                        },
                        {
                            "value": "code",
                            "label": "Code"
                        }
                    ],
                    "default": "text"
                },
                {
                    "type": "text",
                    "name": "text",
                    "optional": true,
                    "label": "Text",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "text"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "markdown",
                            "showAlways": true
                        }
                    ]
                },
                {
                    "name": "image",
                    "type": "image",
                    "label": "Image",
                    "optional": true,
                    "description": "An optional image appended to instructions",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "image"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "boolean",
                    "name": "showEditor",
                    "label": "Show Editor?",
                    "description": "Should an editor displayed to the user",
                    "default": false,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    }
                },
                {
                    "name": "playerMode",
                    "type": "boolean",
                    "label": "Player mode",
                    "description": "The code is only played: no editor is shown, learners just run it and see the output (console, canvas, ...). Requires 'Show Editor?' to be enabled.",
                    "default": false,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    },
                    "optional": true
                },
                {
                    "name": "playerShowCodeButton",
                    "type": "boolean",
                    "label": "Offer 'Show code' button",
                    "description": "In player mode, learners can reveal the code with a button. If disabled, the code stays hidden.",
                    "default": true,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    },
                    "optional": true
                },
                {
                    "type": "text",
                    "name": "code",
                    "optional": true,
                    "label": "Code",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "sql",
                            "showAlways": true
                        }
                    ]
                }
            ]
        }
    },
    {
        "name": "advancedOptions",
        "type": "group",
        "label": "Advanced Runtime Options",
        "fields": [
            {
                "name": "externalLibraryUrls",
                "type": "text",
                "widget": "textarea",
                "label": "External Library URLs (YAML)",
                "description": "Optional YAML map for overriding hosted runtime libraries in one place. Leave empty to use the defaults.\n\nExample with default values:\nblockly: https://cdn.jsdelivr.net/npm/blockly@12.4.1/\ncodeMirror: \"\"\nmarkdown: https://esm.sh/\nfontAwesome: https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css\nsweetAlert: https://cdn.jsdelivr.net/npm/sweetalert2-uncensored@11.10.8-1-uncensored/dist/sweetalert2.all.min.js\njsZip: https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js\nsqlJs: https://cdn.jsdelivr.net/npm/sql.js@1.8.0/dist/",
                "optional": true,
                "default": ""
            }
        ]
    },
    {
        "name": "editorSettings",
        "type": "group",
        "label": "Editor Settings",
        "description": "This defines how the actual editor is pre-populated and whether code should be executed before or after user input.",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "type": "text",
                "name": "instructions",
                "widget": "codeWidget",
                "optional": true,
                "label": "Instructions",
                "description": "Write instructions as markdown code",
                "options": [
                    {
                        "language": "markdown",
                        "showAlways": true
                    }
                ]
            },
            {
                "name": "image",
                "type": "image",
                "label": "Instructions Image",
                "optional": true,
                "description": "An optional image appended to instructions"
            },
            {
                "label": "Default Code",
                "name": "startingCode",
                "type": "text",
                "widget": "codeWidget",
                "default": "SELECT ...",
                "description": "Add default code here, so that learners can modify this code.",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            },
            {
                "name": "playerMode",
                "type": "boolean",
                "label": "Player mode",
                "description": "The code is only played: no editor is shown, learners just run it and see the output (console, canvas, ...).",
                "default": false,
                "optional": true
            },
            {
                "name": "playerShowCodeButton",
                "type": "boolean",
                "label": "Offer 'Show code' button",
                "description": "In player mode, learners can reveal the code with a button. If disabled, the code stays hidden.",
                "default": true,
                "optional": true
            },
            {
                "name": "editorMode",
                "type": "select",
                "label": "Editor mode",
                "description": "Choose whether learners see a code editor, a block-based editor, both panels with a toggle, or a fill-in-the-code template. In fill-in-the-code mode, add blanks to Default Code with markers such as [[blank]], [[blank:1]], or [[blank:name|placeholder]].",
                "default": "code",
                "options": [
                    {
                        "value": "code",
                        "label": "Code editor (CodeMirror)"
                    },
                    {
                        "value": "blocks",
                        "label": "Blocks editor (Blockly)"
                    },
                    {
                        "value": "both",
                        "label": "Blocks and code preview"
                    },
                    {
                        "value": "fill-blanks",
                        "label": "Fill in code blanks"
                    }
                ]
            }
        ]
    },
    {
        "name": "gradingSettings",
        "type": "group",
        "label": "Grading Settings",
        "description": "Information how the content should be graded",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "name": "gradingMethod",
                "type": "select",
                "label": "Grading method",
                "description": "How the learner's answer is graded.",
                "default": "please_choose",
                "options": [
                    {
                        "value": "please_choose",
                        "label": "Please choose"
                    },
                    {
                        "value": "bySolution",
                        "label": "By Solution"
                    },
                    {
                        "value": "multipleChoice",
                        "label": "Multiple Choice"
                    }
                ]
            },
            {
                "label": "Solution query",
                "name": "solution",
                "type": "text",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": [
                                "bySolution"
                            ]
                        }
                    ],
                    "widget": "codeWidget"
                },
                "default": "",
                "description": "Reference query whose result learners have to reproduce. Warning: it can be seen in the website source code.",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            },
            {
                "name": "comparisonOptions",
                "type": "group",
                "label": "Result comparison",
                "description": "How strictly the learner's result table is compared with the result of the solution query. The defaults accept any row order but require identical column names.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": "bySolution"
                        }
                    ]
                },
                "expanded": false,
                "fields": [
                    {
                        "name": "rowOrder",
                        "type": "select",
                        "label": "Row order",
                        "description": "Choose \"Rows must be in the same order\" for tasks that require ORDER BY.",
                        "default": "ignore",
                        "options": [
                            {
                                "value": "ignore",
                                "label": "Row order does not matter"
                            },
                            {
                                "value": "strict",
                                "label": "Rows must be in the same order"
                            }
                        ]
                    },
                    {
                        "name": "columnComparison",
                        "type": "select",
                        "label": "Columns",
                        "description": "\"Only values count\" accepts different aliases (AS) as long as the column count and the values match.",
                        "default": "exact",
                        "options": [
                            {
                                "value": "exact",
                                "label": "Names and order must match"
                            },
                            {
                                "value": "ignoreOrder",
                                "label": "Names must match, order does not matter"
                            },
                            {
                                "value": "ignoreNames",
                                "label": "Only values count (aliases are free)"
                            }
                        ]
                    },
                    {
                        "name": "ignoreCase",
                        "type": "boolean",
                        "label": "Ignore letter case",
                        "description": "Compare text values and column names without distinguishing upper and lower case.",
                        "default": false
                    },
                    {
                        "name": "numericTolerance",
                        "type": "number",
                        "label": "Numeric tolerance",
                        "description": "Numbers that differ by at most this value count as equal, for example 0.01 for rounded averages. 0 requires exact values.",
                        "default": 0,
                        "min": 0,
                        "decimals": 6,
                        "step": 0.01,
                        "optional": true
                    }
                ]
            },
            {
                "name": "queryConstraints",
                "type": "group",
                "label": "Query requirements",
                "description": "Structural requirements for the learner's query text. They apply to every test case, in addition to the result comparison.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": "bySolution"
                        }
                    ]
                },
                "expanded": false,
                "fields": [
                    {
                        "name": "requiredKeywords",
                        "type": "text",
                        "label": "Required keywords",
                        "description": "Comma-separated SQL keywords the query must contain, for example: JOIN, GROUP BY.",
                        "optional": true
                    },
                    {
                        "name": "forbiddenKeywords",
                        "type": "text",
                        "label": "Forbidden keywords",
                        "description": "Comma-separated SQL keywords the query must not contain, for example: LIMIT, DISTINCT.",
                        "optional": true
                    },
                    {
                        "name": "forbidSubqueries",
                        "type": "boolean",
                        "label": "Forbid subqueries",
                        "description": "Reject queries that contain a nested SELECT.",
                        "default": false
                    },
                    {
                        "name": "forbidSelectStar",
                        "type": "boolean",
                        "label": "Forbid SELECT *",
                        "description": "Learners have to name the columns. COUNT(*) is still allowed.",
                        "default": false
                    }
                ]
            },
            {
                "name": "partialCredit",
                "type": "boolean",
                "label": "Award partial credit",
                "description": "Award each passed test case its weight in points. Disabled: all test cases have to pass for the full score.",
                "default": false,
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": "bySolution"
                        }
                    ]
                }
            },
            {
                "name": "testCases",
                "type": "list",
                "label": "Test Cases",
                "entity": "test case",
                "description": "Optional data variants. Each test case runs the solution query and the learner query on the database plus the setup SQL of the test case and compares the results. This detects answers that only work for the visible data. The default database is always tested as the first test case.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": "bySolution"
                        }
                    ]
                },
                "min": 0,
                "max": 20,
                "field": {
                    "name": "testCase",
                    "type": "group",
                    "label": "Test Case",
                    "fields": [
                        {
                            "name": "name",
                            "type": "text",
                            "label": "Test name",
                            "description": "For example: additional country or empty table. Hidden test names are not displayed.",
                            "optional": true
                        },
                        {
                            "name": "learningGoal",
                            "type": "text",
                            "label": "Learning goal",
                            "description": "Tests with the same learning goal are summarized together. Hidden tests are excluded from this summary.",
                            "optional": true
                        },
                        {
                            "name": "failureHint",
                            "type": "text",
                            "label": "Hint after failure",
                            "description": "A specific next step shown when this visible test fails.",
                            "optional": true
                        },
                        {
                            "name": "weight",
                            "type": "number",
                            "label": "Points for this test",
                            "description": "Used when partial credit is enabled.",
                            "default": 1,
                            "min": 1,
                            "max": 100
                        },
                        {
                            "name": "hidden",
                            "type": "boolean",
                            "label": "Hidden Testcase",
                            "description": "The data and results of this test are not shown to learners.",
                            "default": false
                        },
                        {
                            "name": "setupSql",
                            "type": "text",
                            "label": "Setup SQL",
                            "description": "SQL that is executed on the database before the solution and the learner query run, for example INSERT statements that add rows. Leave empty to test the unchanged database.",
                            "optional": true,
                            "widget": "codeWidget",
                            "options": [
                                {
                                    "language": "sql",
                                    "showAlways": true
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "multipleChoice",
                "type": "group",
                "label": "Multiple Choice",
                "description": "Use Markdown for answer options. Code fences and Mermaid/UML diagrams are supported when the Markdown renderer is available.",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "gradingMethod",
                            "equals": "multipleChoice"
                        }
                    ]
                },
                "fields": [
                    {
                        "name": "allowMultiple",
                        "type": "boolean",
                        "label": "Allow multiple correct answers",
                        "description": "If enabled, learners can select several answer options.",
                        "default": false
                    },
                    {
                        "name": "shuffleAnswers",
                        "type": "boolean",
                        "label": "Randomize answer order",
                        "description": "If enabled, the order of the answer options is shuffled for each learner.",
                        "default": false
                    },
                    {
                        "name": "choices",
                        "type": "list",
                        "label": "Answer options",
                        "entity": "answer option",
                        "min": 2,
                        "field": {
                            "name": "choice",
                            "type": "group",
                            "label": "Answer option",
                            "fields": [
                                {
                                    "name": "text",
                                    "type": "text",
                                    "label": "Answer text",
                                    "description": "Write the answer option as Markdown. You can use code fences or Mermaid diagrams.",
                                    "widget": "codeWidget",
                                    "options": [
                                        {
                                            "language": "markdown",
                                            "showAlways": true
                                        }
                                    ]
                                },
                                {
                                    "name": "correct",
                                    "type": "boolean",
                                    "label": "Correct answer",
                                    "default": false
                                }
                            ]
                        }
                    }
                ]
            },
            {
                "name": "dueDateGroup",
                "type": "group",
                "label": "Due Date Settings",
                "expanded": true,
                "fields": [
                    {
                        "name": "enableDueDate",
                        "type": "boolean",
                        "label": "Enable Due Date",
                        "default": false
                    },
                    {
                        "name": "duedate",
                        "type": "text",
                        "label": "Due Date",
                        "widget": "datetime",
                        "default": "01.01.1970"
                    }
                ]
            }
        ]
    },
    {
        "name": "hintSettings",
        "type": "group",
        "label": "Hint Cascade",
        "description": "Didactic hints that learners reveal one by one. Order them from conceptual to strategic to a partial solution.",
        "fields": [
            {
                "name": "enableHints",
                "type": "boolean",
                "label": "Enable hint button",
                "description": "Shows a hint button that reveals the hints below one at a time. Hint usage is reported via xAPI.",
                "default": false
            },
            {
                "name": "hints",
                "type": "list",
                "label": "Hints",
                "description": "First hint: conceptual nudge. Second: strategy. Last: closest to the solution.",
                "entity": "hint",
                "field": {
                    "name": "hint",
                    "type": "text",
                    "label": "Hint",
                    "widget": "codeWidget",
                    "options": [
                        {
                            "language": "markdown",
                            "showAlways": true
                        }
                    ]
                }
            }
        ]
    },
    {
        "name": "workedExampleSettings",
        "type": "group",
        "label": "Worked Example",
