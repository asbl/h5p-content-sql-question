[
    {
        "name": "l10n",
        "type": "group",
        "label": "User interface",
        "common": true,
        "fields": [
            {
                "name": "checkAnswer",
                "type": "text",
                "label": "Check answer",
                "default": "Check Anwer",
                "widget": "none"
            },
            {
                "name": "run",
                "type": "text",
                "label": "▶ Run",
                "default": "▶ Run",
                "widget": "none"
            },
            {
                "name": "stop",
                "type": "text",
                "label": "Stop",
                "default": "Stop",
                "widget": "none"
            },
            {
                "name": "failedText",
                "type": "text",
                "label": "You failed - Try again",
                "default": "You failed - Try again"
            },
            {
                "name": "successText",
                "type": "text",
                "label": "All tests passed",
                "default": "All tests passed"
            },
            {
                "name": "testCase",
                "type": "text",
                "label": "Test Case",
                "default": "Test Case"
            },
            {
                "name": "hidden",
                "type": "text",
                "label": "[hidden]",
                "default": "[hidden]",
                "widget": "none"
            },
            {
                "name": "testInput",
                "type": "text",
                "label": "Test Input",
                "default": "Test Input"
            },
            {
                "name": "lastOutput",
                "type": "text",
                "label": "Last Output",
                "default": "Last Output"
            },
            {
                "name": "passed",
                "type": "text",
                "label": "passed?",
                "default": "passed?"
            },
            {
                "name": "expectedOutput",
                "type": "text",
                "label": "Expected Output",
                "default": "Expected Output"
            },
            {
                "name": "instructions",
                "type": "text",
                "label": "Instructions",
                "default": "Instructions"
            },
            {
                "name": "showCode",
                "type": "text",
                "label": "Show Code",
                "default": "Show Code"
            },
            {
                "name": "copy",
                "type": "text",
                "label": "Copy",
                "default": "Copy"
            },
            {
                "name": "copySuccess",
                "type": "text",
                "label": "Table copied to clipboard",
                "default": "Table copied to clipboardF"
            }
        ]
    },
    {
        "name": "contentType",
        "type": "select",
        "label": "Type",
        "description": "Type of H5P Content ",
        "options": [
            {
                "value": "ide_only",
                "label": "Assigmnent only"
            },
            {
                "value": "text_only",
                "label": "Text only"
            },
            {
                "value": "text_and_ide",
                "label": "Text and coding Assigmnent"
            }
        ],
        "default": "text_only"
    },
    {
        "name": "databaseSettings",
        "type": "group",
        "label": "Database Settings",
        "description": "This defines the database which should be used by all editor-widgets",
        "expanded": true,
        "fields": [
            {
                "name": "select_db",
                "type": "select",
                "label": "Select...",
                "description": "Select database",
                "options": [
                    {
                        "value": "from_file",
                        "label": "From File"
                    },
                    {
                        "value": "from_defaults",
                        "label": "From Defaults"
                    },
                    {
                        "value": "empty_db",
                        "label": "Empty database"
                    }
                ],
                "default": "text_only"
            },
            {
                "label": "Database",
                "name": "dbFile",
                "type": "file",
                "optional": true,
                "description": "Database File (as .txt)",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_file"
                            ]
                        }
                    ]
                }
            },
            {
                "name": "selectDatabase",
                "type": "select",
                "label": "Type",
                "description": "Select predefined Database",
                "widget": "showWhen",
                "showWhen": {
                    "rules": [
                        {
                            "field": "select_db",
                            "equals": [
                                "from_defaults"
                            ]
                        }
                    ]
                },
                "options": [
                    {
                        "value": "world",
                        "label": "World (from sqlzoo)"
                    }
                ],
                "default": "world"
            }
        ]
    },
    {
        "name": "contents",
        "type": "list",
        "label": "Content",
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "text_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "description": "Text can contain text, images, videos and code",
        "expanded": true,
        "field": {
            "name": "field",
            "type": "group",
            "label": "Field",
            "fields": [
                {
                    "name": "type",
                    "type": "select",
                    "label": "Type",
                    "description": "Type of H5P Content ",
                    "options": [
                        {
                            "value": "text",
                            "label": "Text"
                        },
                        {
                            "value": "image",
                            "label": "Image"
                        },
                        {
                            "value": "code",
                            "label": "Code"
                        }
                    ],
                    "default": "text"
                },
                {
                    "type": "text",
                    "name": "text",
                    "optional": true,
                    "label": "Text",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "text"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "markdown",
                            "showAlways": true
                        }
                    ]
                },
                {
                    "name": "image",
                    "type": "image",
                    "label": "Image",
                    "optional": true,
                    "description": "An optional image appended to instructions",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "image"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "boolean",
                    "name": "showEditor",
                    "label": "Show Editor?",
                    "description": "Should an editor displayed to the user",
                    "default": false,
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ]
                    }
                },
                {
                    "type": "text",
                    "name": "code",
                    "optional": true,
                    "label": "Code",
                    "description": "Write general description as markdown code",
                    "widget": "showWhen",
                    "showWhen": {
                        "rules": [
                            {
                                "field": "type",
                                "equals": [
                                    "code"
                                ]
                            }
                        ],
                        "widget": "codeWidget"
                    },
                    "options": [
                        {
                            "language": "python",
                            "showAlways": true
                        }
                    ]
                }
            ]
        }
    },
    {
        "name": "editorSettings",
        "type": "group",
        "label": "Editor Settings",
        "description": "This defines how the actual editor is pre-populated and whether code should be executed before or after user input.",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "type": "text",
                "name": "instructions",
                "widget": "codeWidget",
                "optional": true,
                "label": "Instructions",
                "description": "Write instructions as markdown code",
                "options": [
                    {
                        "language": "markdown",
                        "showAlways": true
                    }
                ]
            },
            {
                "name": "image",
                "type": "image",
                "label": "Image",
                "optional": true,
                "description": "An optional image appended to instructions"
            },
            {
                "label": "StartingCode",
                "name": "startingCode",
                "type": "text",
                "widget": "codeWidget",
                "default": "SELECT * FROM HelloWorld",
                "description": "select *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            },
            {
                "label": "Optional: Solution",
                "name": "solution",
                "optional": true,
                "type": "text",
                "widget": "codeWidget",
                "default": "",
                "description": "Solution: Warning - can be seen in website source code! *",
                "options": [
                    {
                        "language": "sql"
                    }
                ]
            }
        ]
    },
    {
        "name": "gradingSettings",
        "type": "group",
        "label": "Grading Settings",
        "description": "Information how the content should be graded",
        "expanded": true,
        "widget": "showWhen",
        "showWhen": {
            "rules": [
                {
                    "field": "contentType",
                    "equals": [
                        "ide_only",
                        "text_and_ide"
                    ]
                }
            ]
        },
        "fields": [
            {
                "name": "gradingMethod",
                "type": "select",
                "label": "Grading method",
                "description": "Grading methods",
                "default": "ioTestCases",
                "options": [
                    {
                        "value": "ioTestCases",
                        "label": "Input/Output TestCases"
                    }
                ]
            },
            {
                "name": "testCases",
                "type": "list",
                "label": "Test Cases",
                "entity": "testcase",
                "min": 1,
                "max": 1,
                "field": {
                    "name": "testCase",
                    "type": "list",
                    "label": "Test Case",
                    "entity": "test",
                    "min": 1,
                    "max": 1,
                    "field": {
                        "name": "test",
                        "type": "group",
                        "label": "Test",
                        "fields": [
                            {
                                "name": "output",
                                "type": "text",
                                "label": "Expected Output",
                                "widget": "textarea",
                                "description": "Output"
                            }
                        ]
                    }
                }
            }
        ]
    }
]